# --- Compilazione PlatformIO / C++ (in qualsiasi sottocartella) ---
**/.pio/
**/.vscode/.browse.c_cpp.db*
**/.vscode/c_cpp_properties.json
**/.vscode/launch.json
**/.vscode/ipch

# --- Python & Ambiente Virtuale ---
**/__pycache__/
**/*.py[cod]
**/venv/
**/.env

# --- Database SQLite (compresi i file WAL/SHM di concorrenza) ---
**/*.db
**/*.db-wal
**/*.db-shm
**/*.sqlite3

# --- Foto caricate da Admin e Giocatori PRO ---
server/static/uploads/*
!server/static/uploads/.gitkeep

# --- Backup locali scaricati dal server Ubuntu ---
backups/

# --- File di sistema ---
**/.DS_Store
**/Thumbs.db